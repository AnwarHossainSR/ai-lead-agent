# Normalise line endings so Windows and CI agree on file contents.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Generated — excluded from diffs and language statistics.
pnpm-lock.yaml linguist-generated=true -diff
packages/database/drizzle/*.sql linguist-generated=true -diff
packages/database/drizzle/meta/** linguist-generated=true -diff

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
