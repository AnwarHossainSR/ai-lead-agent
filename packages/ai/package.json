{
  "name": "@mela/ai",
  "version": "0.0.0",
  "private": true,
  "description": "The platform's only sanctioned path to a language model: versioned prompts, schema-validated output, and usage/cost accounting",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "catalog:",
    "@mela/config": "workspace:*",
    "@mela/database": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mela/eslint-config": "workspace:*",
    "@mela/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
