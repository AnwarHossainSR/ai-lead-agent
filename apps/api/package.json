{
  "name": "@mela/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS REST API",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch --no-experimental-strip-types --disable-warning=ExperimentalWarning -r @swc-node/register src/main.ts",
    "worker": "node --watch --no-experimental-strip-types --disable-warning=ExperimentalWarning -r @swc-node/register src/worker.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mela/ai": "workspace:*",
    "@mela/config": "workspace:*",
    "@mela/database": "workspace:*",
    "@mela/shared": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/terminus": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "bullmq": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@mela/tsconfig": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "playwright": "^1.62.1",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
