{
  "name": "middle-east-lead-agent",
  "version": "0.0.0",
  "private": true,
  "description": "AI-assisted B2B lead generation and sales intelligence platform for the Middle East",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,worker,web --prefix \"[{name}]\" \"pnpm --filter @mela/api dev\" \"pnpm --filter @mela/api worker\" \"pnpm --filter @mela/web dev\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "biome": "biome check --write .",
    "biome:check": "biome check .",
    "db:fresh": "pnpm db:reset && pnpm db:migrate && pnpm db:seed:accounts",
    "db:seed:dev": "pnpm db:seed:accounts",
    "db:reset": "pnpm --filter @mela/database db:reset",
    "db:migrate": "pnpm --filter @mela/database db:migrate",
    "db:seed:accounts": "pnpm --filter @mela/api seed:accounts",
    "db:seed:data": "pnpm --filter @mela/database db:seed",
    "db:fresh:seed": "pnpm db:fresh && pnpm db:seed:data"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "concurrently": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
