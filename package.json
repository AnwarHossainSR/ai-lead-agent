{
  "name": "middle-east-lead-agent",
  "version": "0.0.0",
  "private": true,
  "description": "AI-assisted B2B lead generation and sales intelligence platform for the Middle East",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "biome": "biome check --write .",
    "biome:check": "biome check .",
    "db:fresh": "pnpm --filter @mela/database db:fresh"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
