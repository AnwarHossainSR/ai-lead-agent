# Every environment variable this project reads, with a placeholder value and
# a note on what it is for. This file is committed; the files holding real
# values are not.
#
#   .env                  root — read by Docker Compose, the API and the packages
#   apps/web/.env.local   read by Next.js
#
# First-time setup:
#   cp .env.example .env
#   cp .env.example apps/web/.env.local
#
# The placeholders below are local-development values, not secrets. Never put a
# real credential in this file — it is tracked by git.

# ---------------------------------------------------------------------------
# Docker Compose — backing services (root .env only)
# ---------------------------------------------------------------------------

# PostgreSQL superuser the container is created with. Must match the user in
# DATABASE_URL.
POSTGRES_USER=mela

# PostgreSQL password the container is created with. Must match the password in
# DATABASE_URL. Changing it after the volume exists has no effect until the
# volume is removed with `docker compose down -v`.
POSTGRES_PASSWORD=mela_local_dev

# Database created on first start. Must match the database name in DATABASE_URL.
POSTGRES_DB=mela

# Host port PostgreSQL is published on. Change it if 5432 is already taken;
# remember to change DATABASE_URL to match.
POSTGRES_PORT=5432

# Host port Redis is published on. Change it if 6379 is already taken; remember
# to change REDIS_URL to match.
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# API — apps/api (root .env)
# ---------------------------------------------------------------------------

# Runtime mode. Anything other than `development` emits structured JSON logs
# instead of pretty console output. One of: development, test, production.
NODE_ENV=development

# TCP port the API listens on. Must match the port in API_URL and
# NEXT_PUBLIC_API_URL.
API_PORT=3001

# Origin the web application is served from. The API permits CORS requests from
# this origin and no other.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — apps/api, packages/database, migrations and the seed script
# ---------------------------------------------------------------------------

# PostgreSQL connection string for the application database. Also read by
# drizzle-kit when generating and applying migrations. Never logged and never
# returned in a health response.
DATABASE_URL=postgresql://mela:mela_local_dev@localhost:5432/mela

# Redis connection string. Used today only by the API health check; the
# background job queues arrive in a later phase.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# AI providers — apps/api, packages/ai (root .env)
#
# Two vendors, one per tier: Gemini for the default (reasoning) tier,
# Cloudflare Workers AI for the fast (classification) tier.
# ---------------------------------------------------------------------------

# Google Gemini API key, used for the default tier. Get one at
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Cloudflare account id. Workers AI is called at a URL scoped to this
# account. Found on the Cloudflare dashboard's account home.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token scoped to Workers AI, used for the fast tier. Create
# one at https://dash.cloudflare.com/profile/api-tokens.
CLOUDFLARE_API_TOKEN=

# Gemini model identifier for the default tier: evidence-weighted reasoning
# over research and analysis.
AI_MODEL_DEFAULT=gemini-2.5-pro

# Cloudflare Workers AI model identifier for the fast tier: cheap
# classification and short extraction. Must support function calling.
AI_MODEL_FAST=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Maximum output tokens requested per model call.
AI_MAX_OUTPUT_TOKENS=4096

# Bound on a single model call, in milliseconds. These are long analytical
# calls, not request-path work.
AI_TIMEOUT_MS=60000

# Maximum estimated spend permitted within AI_SPEND_WINDOW_HOURS before
# further calls are refused.
AI_SPEND_CEILING_USD=20

# Rolling window, in hours, over which AI_SPEND_CEILING_USD is enforced.
AI_SPEND_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# Web — apps/web (apps/web/.env.local)
# ---------------------------------------------------------------------------

# Base URL of the API as reached from the browser. NEXT_PUBLIC_ variables are
# inlined into the client bundle at build time, so this must never carry a
# credential.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Base URL of the API as reached from the Next.js server while rendering.
# Usually identical to NEXT_PUBLIC_API_URL in development.
API_URL=http://localhost:3001
