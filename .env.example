# Every environment variable this project reads. The placeholders are
# local-development values, not secrets. This file is committed; the files
# holding real values (.env, apps/web/.env.local) are not.
#
# First-time setup:
#   cp .env.example .env
#   cp .env.example apps/web/.env.local

# ---------------------------------------------------------------------------
# API — apps/api (root .env)
# ---------------------------------------------------------------------------

# Runtime mode. Anything other than `development` emits structured JSON logs.
# One of: development, test, production.
NODE_ENV=development

# TCP port the API listens on. Must match the port in API_URL and
# NEXT_PUBLIC_API_URL.
API_PORT=4000

# TCP port the Prometheus metrics endpoint is served on. Must differ from
# API_PORT.
METRICS_PORT=9090

# Minimum severity written to structured logs. One of: error, warn, log,
# debug, verbose.
LOG_LEVEL=log

# PostgreSQL connection string for the application database. Read by the API,
# by drizzle-kit when generating and applying migrations, and by the seed
# script. For local development, use your local PostgreSQL instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mela

# Redis connection string. Used by the API health check and the job queues.
# Use an Upstash connection string (rediss://) in development; the CI workflow
# provisions a Redis container instead.
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_INSTANCE.upstash.io:6379

# Origin the web application is served from. The API permits CORS requests from
# this origin and no other.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# AI providers — apps/api, packages/ai (root .env)
#
# Two vendors, one per tier: Gemini for the default (reasoning) tier,
# Cloudflare Workers AI for the fast (classification) tier.
# ---------------------------------------------------------------------------

# Google Gemini API key, used for the default tier.
GEMINI_API_KEY=

# Cloudflare account id. Workers AI is called at a URL scoped to this account.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token scoped to Workers AI, used for the fast tier.
CLOUDFLARE_API_TOKEN=

# Gemini model identifier for the default tier.
AI_MODEL_DEFAULT=gemini-2.5-pro

# Cloudflare Workers AI model identifier for the fast tier.
AI_MODEL_FAST=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Maximum output tokens requested per model call.
AI_MAX_OUTPUT_TOKENS=4096

# Bound on a single model call, in milliseconds.
AI_TIMEOUT_MS=60000

# Maximum estimated spend permitted within AI_SPEND_WINDOW_HOURS.
AI_SPEND_CEILING_USD=20

# Rolling window, in hours, over which AI_SPEND_CEILING_USD is enforced.
AI_SPEND_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# Discovery sources — apps/api (root .env)
# ---------------------------------------------------------------------------

# API key for the licensed places provider. When absent the places source is
# disabled for the run.
PLACES_API_KEY=

# Base URL for the licensed places provider.
PLACES_BASE_URL=https://api.places.example.com/v1

# ---------------------------------------------------------------------------
# Website analysis — apps/api (root .env)
# ---------------------------------------------------------------------------

# Directory where analysis artifacts (screenshots, HTML, audit reports) are
# stored. Created at startup if absent.
ANALYSIS_ARTIFACT_ROOT=./analysis-artifacts

# Maximum time in milliseconds to wait for a page to reach its load condition.
ANALYSIS_NAVIGATION_TIMEOUT_MS=30000

# Maximum total time in milliseconds for an entire analysis run.
ANALYSIS_RUN_TIMEOUT_MS=120000

# Maximum allowed page weight in bytes (10MB default).
ANALYSIS_MAX_PAGE_BYTES=10485760

# Maximum time in milliseconds the worker waits for active jobs to finish during graceful shutdown.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# QStash base URL.
QSTASH_URL=https://qstash-eu-central-1.upstash.io

# QStash bearer token.
QSTASH_TOKEN=

# Current QStash signing key for webhook verification.
QSTASH_CURRENT_SIGNING_KEY=

# Next QStash signing key for rotation.
QSTASH_NEXT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Authentication — apps/api (root .env)
# ---------------------------------------------------------------------------

# Secret used to sign session cookies. This placeholder is only accepted in
# development; generate a real one with `openssl rand -hex 32` for anything
# else.
SESSION_SECRET=changeme-generate-a-real-secret-with-openssl-rand-hex-32

# Destination URL for unhandled exception and rejection reports. When absent,
# error reporting is a no-op.
ERROR_REPORTING_DSN=

# ---------------------------------------------------------------------------
# Web — apps/web (apps/web/.env.local)
# ---------------------------------------------------------------------------

# Base URL of the API as reached from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base URL of the API as reached from the Next.js server while rendering.
API_URL=http://localhost:4000

# Optional, development only: prefills the sign-in form. Left unset, the form
# prefills the operator account `pnpm --filter @mela/api seed:accounts` creates
# (dev@mela.local). Both are ignored when NODE_ENV=production.
DEV_SIGN_IN_EMAIL=
DEV_SIGN_IN_PASSWORD=
